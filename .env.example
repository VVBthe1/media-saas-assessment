# Local development values only. Copy to .env to override defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=control_plane
# Host port for Postgres; change if 5432 is already in use locally.
POSTGRES_HOST_PORT=5432

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Used when running the app outside Docker. Inside Docker, compose builds these from the values above.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/control_plane
BROKER_URL=amqp://guest:guest@127.0.0.1:5672/
